# Secrets — never commit these. Cloudflare Worker secrets are set via
# `wrangler secret put` or the dashboard, never stored in this repo.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/
**/credentials.json
**/service-account*.json

# Local tooling
node_modules/
.wrangler/
.DS_Store
*.log
.vscode/
.claude/

# Generated by scripts/build-public-dist.mjs — the only thing ever deployed
# to Cloudflare Pages (see .github/workflows/deploy.yml). Never commit the
# build output itself; commit the allowlist script instead.
public-dist/

# VERALIQ Digital Human Engine — voice biometric material, never committed
# (see services/tts/README.md — spec section 4's consent rule)
services/tts/voice_profiles/*.wav

__pycache__/
*.pyc

# Yedekler ve büyük binary'ler repo köküne düşerse görmezden gel (D:\yedekler'e taşınmalı)
*.sql
*.bundle
